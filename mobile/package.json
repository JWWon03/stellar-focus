{
  "name": "stellar-focus-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Stellar Focus 안드로이드 래퍼 (Capacitor)",
  "type": "module",
  "scripts": {
    "sync-web": "node sync-web.mjs",
    "prepare-android": "npm run sync-web && npx cap sync android && npm run install-res",
    "open-android": "npx cap open android",
    "apk": "npm run prepare-android && cd android && gradlew.bat assembleDebug",
    "install-res": "node install-res.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
